# MongoDB Atlas: use a database name in the URI; MONGODB_DB is an optional override.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/smartfarm
AUTH_SECRET=replace-with-a-generated-secret
# Set the canonical public HTTPS URL in production (leave blank for localhost).
AUTH_URL=

# Optional; npm run bootstrap:admin prompts interactively when these are absent.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# Open-Meteo uses each farm's coordinates and needs no API key.
WEATHER_ENABLED=true

# Official Meta WhatsApp Cloud API. Never enable until test recipient is authorized.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_API_VERSION=v27.0
WHATSAPP_TEST_TEMPLATE=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US
