# Frontend preview works without these values. Configure them for server/API work.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/smartfarm
AUTH_SECRET=replace-with-a-generated-secret

# Use only to bootstrap an administrator; clear the bootstrap password afterwards.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-before-bootstrap
ADMIN_BOOTSTRAP_NAME=Administrator

# Keep integrations disabled until real provider credentials are available.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEST_RECIPIENT=
WEATHER_ENABLED=false
WEATHER_API_URL=
WEATHER_API_KEY=
WEATHER_LOCATION=
